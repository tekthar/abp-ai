<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- One version for every package (see CHANGELOG.md); a VersionSuffix makes a prerelease. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>

    <Authors>AbpAi contributors</Authors>
    <Company>Tekthar</Company>
    <Copyright>Copyright 2026 AbpAi contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/todahq/abp-ai</PackageProjectUrl>
    <RepositoryUrl>https://github.com/todahq/abp-ai.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ai;llm;gateway;anthropic;openai;limits;abp;efcore;postgresql</PackageTags>
    <PackageReleaseNotes>https://github.com/todahq/abp-ai/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AbpVersion>10.6.1</AbpVersion>
    <!-- AbpAgent's contracts, for AbpAi.Agents: a checkout of todahq/toda-agents beside this one, until they're on nuget.org. -->
    <AbpAgentContractsDir Condition="'$(AbpAgentContractsDir)' == ''">$(MSBuildThisFileDirectory)../toda-agents/src/Toda.Agents.Contracts/</AbpAgentContractsDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
