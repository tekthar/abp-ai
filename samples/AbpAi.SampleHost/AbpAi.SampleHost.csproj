<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>A host of AbpAi alone: an organization's departments over its projects as the gateway's scopes, the demo model as its provider, and the gateway's API over HTTP. What Insight does to use the gateway, and what AbpAi.Host.Tests proves.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AbpAi\AbpAi.csproj" />
    <PackageReference Include="Volo.Abp.Autofac" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="$(AbpVersion)" />
    <!-- For its migrations (dotnet ef migrations add), as a host has for its own. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>

</Project>
