<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AbpAi: the model gateway for ABP applications. Aliases, connections, providers (Anthropic, OpenAI-compatible, a demo model), limits per scope and per person on a usage ledger, rules for which data may go to which provider, and usage people can read.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbpAi.Contracts\AbpAi.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.Security" Version="$(AbpVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AbpAi.Tests" />
  </ItemGroup>

</Project>
