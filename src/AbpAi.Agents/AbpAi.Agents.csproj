<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AbpAgent's model (IAgentModels) on top of AbpAi's IAi, so neither package needs the other: an agent's calls get the gateway's aliases, limits, data rules and usage.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbpAi\AbpAi.csproj" />
    <PackageReference Include="AbpAgent.Contracts" Version="$(AbpAgentVersion)" />
  </ItemGroup>

</Project>
